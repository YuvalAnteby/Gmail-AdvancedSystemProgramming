<!-- compose_fragment.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TO field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="clear_text">

            <!-- Dropdown with overlay + filtering -->
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/et_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/send_to"
                android:inputType="textEmailAddress|textNoSuggestions"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Selected recipients as chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_recipients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            app:singleLine="false"
            app:singleSelection="false"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp" />

        <!-- Subject -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/compose_subject" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Body -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/compose_body"
                android:inputType="textMultiLine"
                android:minLines="8" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Attachments header + add button -->
        <LinearLayout
            android:id="@+id/attachments_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btn_add_attachment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compose_add_attachment" />

            <!-- Optional little hint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:text="@string/compose_attachment_hint" />
        </LinearLayout>

        <!-- Selected attachments as removable chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_attachments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            app:singleLine="false"
            app:singleSelection="false"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp" />


        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btn_send"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:text="@string/compose_send" />

            <Button
                android:id="@+id/btn_save"
                style="@style/btnSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:text="@string/compose_save_draft" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
