<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.inbox_activity.InboxActivity">

    <!-- Main content including Toolbar and Fragment -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- custom toolbar -->
        <LinearLayout
            android:id="@+id/custom_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Hamburger icon -->
            <ImageView
                android:id="@+id/hamburger_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/menu_description"
                android:padding="1dp"
                android:src="@drawable/ic_menu"
                app:tint="?attr/colorOnSurface" />

            <!-- Search bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_bar_container"
                style="@style/etSearchBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/search_bar_hint"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- User profile picture -->
            <FrameLayout
                android:id="@+id/profile_container"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/circle_background">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/user_avatar"
                    style="@style/imgAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/profile_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile_default"
                    app:shapeAppearanceOverlay="@style/image_checkbox" />
            </FrameLayout>

        </LinearLayout>

        <!-- action bar -->
        <LinearLayout
            android:id="@+id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorPrimary"
            android:visibility="gone"
            android:padding="8dp">

            <!-- Back/Cancel icon -->
            <ImageButton
                android:id="@+id/btn_close_action_bar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/close_action_bar"
                android:backgroundTint="@android:color/transparent"
                app:tint="?attr/colorOnPrimary" />

            <!-- Spacer to push the action buttons to the end -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_trash_restore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_mail"
                android:backgroundTint="@android:color/transparent"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_trash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_delete"
                android:contentDescription="@string/delete_mail"
                android:padding="8dp"
                android:backgroundTint="@android:color/transparent"
                app:tint="?attr/colorOnPrimary" />

            <!-- Actions (e.g. mark read, trash, spam) -->
            <ImageButton
                android:id="@+id/btn_mark_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_read"
                android:contentDescription="@string/mark_as_read"
                android:padding="8dp"
                android:backgroundTint="@android:color/transparent"
                app:tint="?attr/colorOnPrimary" />

            <ImageButton
                android:id="@+id/btn_toggle_spam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_report"
                android:contentDescription="@string/report_mail"
                android:padding="8dp"
                android:backgroundTint="@android:color/transparent"
                app:tint="?attr/colorOnPrimary" />

            <ImageButton
                android:id="@+id/btn_labels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="TODO"
                android:paddingTop="8dp"
                android:backgroundTint="@android:color/transparent"
                android:src="@drawable/ic_label"/>

        </LinearLayout>


        <!-- Fragment container -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:name="androidx.fragment.app.Fragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Side Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:paddingTop="24dp"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>